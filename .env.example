# SourcBuy 环境变量清单（只有名字，值找罗总要；绝不提交真实值到 git）

# ── 平台/应用 ─────────────────────────────────────────────────
APP_ID=                   # 应用 ID
APP_SECRET=               # 应用密钥（JWT 签名）
VITE_APP_ID=              # 前端可见的应用 ID

# ── 数据库 ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL 兼容连接串（mysql://user:pass@host:port/db）

# ── Kimi agent-gw（AI 模型与存储通道）─────────────────────────
KIMI_AGENTGW_API_KEY=
KIMI_AGENTGW_BASE_URL=
KIMI_STORAGE_RESOURCE_ID=

# ── 聚合数据通道（服务端专用）─────────────────────────────────
ALIBABA_AGG_BASE=
ALIBABA_AGG_TOKEN=

# ── 万邦 onebound（主力货源 API，按次计费）─────────────────────
WANBANG_BASE=
WANBANG_KEY=
WANBANG_SECRET=

# ── 点金（灾备货源 API，HTTP 直连）────────────────────────────
DIANJIN_BASE=
DIANJIN_USER=
DIANJIN_PASS=
DIANJIN_KEY_ID=

# ── sunclub（罗总自有爬虫接口，详情主力）────────────────────────
SUNCLUB_BASE=             # 含 token 的完整基址

# ── 1688 账号（Mac 采集包扫码/登录用，绝不进前台）──────────────
ALI_1688_USER=
ALI_1688_PASS=
